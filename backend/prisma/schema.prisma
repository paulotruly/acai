generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  nome         String?
  senha        String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

enum Sentimento {
  POSITIVO
  NEGATIVO
  NEUTRO
  MISTO
}

model TipoEvento {
  id           Int       @id @default(autoincrement())
  nome         String    @unique
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  noticias     Noticia[]
}

model Noticia {
  id                     Int         @id @default(autoincrement())
  titulo                 String?
  data                   DateTime?
  fonte                  String
  url                    String      @unique
  textoCompleto          String      @db.Text
  tipoEventoId           Int?
  tipoEvento             TipoEvento? @relation(fields: [tipoEventoId], references: [id])
  localizacaoTexto       String?
  bairro                 String?
  ruaOuPontoDeReferencia String?
  pessoasAfetadas        String?     @db.Text
  danoMaterial           String?     @db.Text
  problemaInfraestrutura String?     @db.Text
  depoimentoMorador      String?     @db.Text
  depoimentoInstituicao  String?     @db.Text
  sentimento             Sentimento?
  temas                  Json?
  latitude               Float?
  longitude              Float?
  criadoEm               DateTime    @default(now())
  atualizadoEm           DateTime    @updatedAt
}
